{
  "name": "traveltea-backend",
  "version": "1.0.0",
  "description": "AI-powered travel planner backend with MCP and LangGraph",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node server.js",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "mcp:verify": "tsx src/mcp/verify.ts",
    "places:test-api": "tsx src/mcp-servers/places/test-manual.ts",
    "travel:agent": "tsx src/agents/test-agents.ts",
    "vector:seed": "tsx src/vector/scripts/seed-knowledge.ts",
    "mcp:verify-exec": "tsx src/mcp/verify-execution.ts",
    "mcp:verify-present": "tsx src/mcp/verify-presentation.ts",
    "qa:api": "tsx src/scripts/qa-api-sweep.ts",
    "qa:parser": "tsx src/scripts/qa-parser.ts",
    "qa:vector": "tsx src/scripts/qa-vector-check.ts",
    "fix:vector": "tsx src/scripts/fix-vector-index.ts",
    "qa:agent": "tsx src/scripts/qa-agent-flow.ts",
    "qa:booking": "tsx src/scripts/qa-booking-feature.ts",
    "qa:trip": "tsx src/scripts/qa-trip-planning.ts",
    "fix:trip-index": "tsx src/scripts/fix-trip-search-index.ts",
    "qa:search": "tsx src/scripts/qa-search.ts"
  },
  "keywords": [
    "travel",
    "ai",
    "mcp",
    "langgraph"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^1.2.2",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.4.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.7.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.4.0",
    "mongoose": "^8.7.0",
    "serpapi": "^2.2.1",
    "socket.io": "^4.8.0",
    "uuid": "^14.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
